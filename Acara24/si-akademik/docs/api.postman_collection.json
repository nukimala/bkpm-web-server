{
    "info": {
        "_postman_id": "a1b2c3d4-1111-4444-8888-siakademikapipostman",
        "name": "SI Akademik API",
        "description": "Koleksi endpoint API REST project SI Akademik (Acara 15-19). Login terlebih dahulu untuk mendapatkan token yang tersimpan otomatis pada variabel {{auth_token}}.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Autentikasi",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"login sukses dan token tersimpan\", function () {",
                                    "    var json = pm.response.json();",
                                    "    pm.expect(json.success).to.eql(true);",
                                    "    pm.collectionVariables.set(\"auth_token\", json.data.token);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "response": [
                        {
                            "name": "Login sukses",
                            "originalRequest": {
                                "method": "POST",
                                "url": "{{base_url}}/api/auth/login"
                            },
                            "status": "Created",
                            "code": 200,
                            "body": "{\n    \"success\": true,\n    \"message\": \"Login berhasil.\",\n    \"data\": {\n        \"token\": \"...64 karakter hex...\",\n        \"type\": \"Bearer\",\n        \"expires_at\": \"2026-09-29 10:00:00\",\n        \"user\": \"admin\"\n    }\n}"
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "logout"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
